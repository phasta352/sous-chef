{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sous-chef",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sous-chef",
      "database_id": "fe62912b-0bfd-4c9c-bf69-0ff5b3d69be9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "broken-snowflake-9ddc.cloudflareaccess.com",
    "ACCESS_AUD": "95059a1661571d6f28a404da66b221f947b88b8c6ea90bb61e4932a4b92f8a70"
  },
  "observability": { "enabled": true }
}
